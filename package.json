{
  "name": "ca-control-macos",
  "version": "0.1.0",
  "private": true,
  "productName": "CA Control",
  "description": "Настройка и диагностика прокси на macOS",
  "main": "app/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.cjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.cacontrol.macos",
    "files": ["app/**/*", "package.json"],
    "extraResources": [{ "from": "build/ca-local-services", "to": "ca-local-services" }],
    "mac": { "category": "public.app-category.utilities", "hardenedRuntime": true },
    "directories": { "output": "dist" }
  }
}
